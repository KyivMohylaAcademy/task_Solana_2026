      "instruction": "list_item",
      "args": {
        "price": 1000
      },
      "accounts": {
        "listing": "PDA: [b'listing', item_mint]",
        "item_mint": "Signer",
        "seller": "Signer",
        "system_program": "System Program"
      },
      "result": {
        "event": "ItemListed",
        "seller": "seller_pubkey",
        "item_mint": "item_mint_pubkey",
        "price": 1000
      }
    },
    "buy_item": {
      "instruction": "buy_item",
      "accounts": {
        "listing": "PDA: [b'listing', item_mint]",
        "item_mint": "Signer",
        "buyer": "Signer",
