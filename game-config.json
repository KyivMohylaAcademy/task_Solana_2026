  "example_transaction": {
    "search_resources": {
      "instruction": "search_resources",
      "accounts": {
        "player_search": "PDA: [b'player_search', owner]",
        "owner": "Signer",
        "clock": "SYSVAR_CLOCK_PUBKEY",
